#!/usr/bin/env bash
# Pre-push gate: scan the commits about to be pushed for secrets and personal/network
# data with gitleaks (.gitleaks.toml). Refuses the push on any finding, and when gitleaks
# is missing (fail closed). Install: scripts/install-hooks.sh
set -euo pipefail

zero=0000000000000000000000000000000000000000
root=$(git rev-parse --show-toplevel)
config="$root/.gitleaks.toml"

command -v gitleaks >/dev/null 2>&1 || {
  echo "pre-push: gitleaks not found; install it (https://github.com/gitleaks/gitleaks), push refused." >&2
  exit 1
}
[ -f "$config" ] || { echo "pre-push: $config missing, push refused." >&2; exit 1; }

status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # branch deletion
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha --not --remotes" # new branch: every commit no remote has yet
  else
    range="$remote_sha..$local_sha"
  fi
  if ! gitleaks detect --source "$root" --config "$config" --log-opts "$range" \
    --redact --no-banner --exit-code 1 >&2; then
    echo "pre-push: sensitive data found in $range; push refused (see findings above)." >&2
    status=1
  fi
done
exit $status
