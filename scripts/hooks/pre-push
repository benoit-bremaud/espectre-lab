#!/usr/bin/env bash
# Pre-push gate: scan the commits about to be pushed for secrets and personal/network
# data with gitleaks (.gitleaks.toml). Refuses the push on any finding, and when gitleaks
# is missing (fail closed). Install: scripts/install-hooks.sh
set -euo pipefail

zero=0000000000000000000000000000000000000000
remote=${1:-origin} # git passes the remote name as $1
root=$(git rev-parse --show-toplevel)
config="$root/.gitleaks.toml"

command -v gitleaks >/dev/null 2>&1 || {
  echo "pre-push: gitleaks not found; install it (https://github.com/gitleaks/gitleaks), push refused." >&2
  exit 1
}
[ -f "$config" ] || { echo "pre-push: $config missing, push refused." >&2; exit 1; }

status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # branch deletion
  if [ "$remote_sha" != "$zero" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    range="$remote_sha..$local_sha"
  else
    # New branch, or a remote tip we have not fetched: gitleaks scans nothing (and passes)
    # on an unknown sha, so scan every commit this remote does not have yet.
    range="$local_sha --not --remotes=$remote"
  fi
  # </dev/null: gitleaks must not swallow the remaining ref lines of a multi-ref push.
  if ! gitleaks git --config "$config" --log-opts "$range" \
    --redact --verbose --no-banner --exit-code 1 "$root" >&2 </dev/null; then
    echo "pre-push: sensitive data found in $range; push refused (see findings above)." >&2
    status=1
  fi
done
exit $status
